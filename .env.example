# Detox Pass — exemplo de variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha com valores de TESTE/DESENVOLVIMENTO.
# NUNCA coloque secrets reais aqui nem commite o seu `.env`.
# Secrets de produção nunca entram no código, commit ou prompt do Cursor.
#
# Obs.: a lista definitiva de variáveis será consolidada no bootstrap técnico
# (liderado por Elias). Abaixo estão apenas as previstas pela stack de referência.

# Supabase (client-side — seguro expor no frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (server-side apenas — NUNCA expor no frontend/mobile)
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe (usar chaves de modo de teste em local/staging)
# VITE_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Gusto (somente secrets da Edge Function — NUNCA no frontend)
# Enquanto estes valores estiverem vazios, GUSTO_ENABLED fica false e nenhuma chamada sai.
# GUSTO_ENABLED=false
# GUSTO_ENV=demo
# GUSTO_BASE_URL=https://api.gusto-demo.com
# GUSTO_CLIENT_ID=
# GUSTO_CLIENT_SECRET=
# GUSTO_COMPANY_UUID=
# GUSTO_API_VERSION=2026-06-15
# Scopes da Application (não são secrets):
# contractors:manage
# contractor_payment_methods:write
# payrolls:run  (somente na POC de pagamento)
