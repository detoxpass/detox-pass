# EditorConfig — mantém consistência entre os desenvolvedores
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,jsx,ts,tsx,json,jsonc}]
indent_size = 2

[*.md]
# Não remover espaços no fim das linhas em Markdown (quebra de linha com 2 espaços)
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
